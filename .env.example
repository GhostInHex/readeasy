# OpenRouter key used by the Restructure step (POST /api/transform).
# Get one at https://openrouter.ai/keys
OPENROUTER_API_KEY=

# Optional: override the restructure model. Default: openrouter/free (meta-router over free models)
# OPENROUTER_MODEL=

# Optional: comma-separated fallback models, tried in order when the primary fails in a way
# another model could fix (rate limit, outage, timeout, unusable answer).
# Default: none — openrouter/free already fails over server-side.
# OPENROUTER_FALLBACK_MODELS=

# Optional: set to "stub" to force the canned Restructure stub instead of a live LLM call.
# READEASY_LLM_MODE=
